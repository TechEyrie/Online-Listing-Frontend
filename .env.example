# Suqora Web (Next.js) — copy to `.env.local`

# Public site URL (your Vercel domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Suqora

# Browser API base. Prefer `/api` so auth cookies stay first-party on Vercel
# (Next rewrites /api → your Render backend via API_PROXY_TARGET).
NEXT_PUBLIC_API_URL=/api

# Upstream Express API used by Next rewrites + server-side fetch (sitemap/metadata)
# Local: http://127.0.0.1:5000/api
# Production: https://YOUR-SERVICE.onrender.com/api
API_PROXY_TARGET=http://127.0.0.1:5000/api
API_INTERNAL_URL=http://127.0.0.1:5000/api

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
